# FloodSense AI — Frontend Environment Variables
# Copy this file to .env.local:   cp .env.example .env.local

# Backend API (use localhost for local dev, Render URL for production)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Supabase (optional — only needed for realtime DB features)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

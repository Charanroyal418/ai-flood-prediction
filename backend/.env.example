# FloodSense AI — Backend Environment Variables
# Copy this file to .env:   cp .env.example .env

# Database (SQLite works out of the box for local dev)
DATABASE_URL=sqlite:///./floodsense.db

# Security (dev defaults — change in production)
SECRET_KEY=floodsense_dev_secret_key_change_in_production
ALGORITHM=HS256

# CORS — frontend origins allowed
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Admin account created on first run
FIRST_ADMIN_EMAIL=admin@floodsense.ai
FIRST_ADMIN_PASSWORD=changeme_in_production_2026

# ML Pipeline timing
PIPELINE_INTERVAL_SECONDS=20
ETL_INTERVAL_SECONDS=300

# NASA GPM (optional — disabled by default)
# NASA_GPM_ENABLED=true
# NASA_GPM_TOKEN=your_earthdata_token_here

# Redis (optional — app works without it)
# REDIS_URL=redis://localhost:6379/0
